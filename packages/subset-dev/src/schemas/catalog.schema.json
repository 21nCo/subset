{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "subset.catalog@1",
  "description": "What Subset ships and where to get it: macOS apps by channel and npm command-line tools by dist-tag. Closed: an unknown field anywhere is invalid. A reader also refuses a document larger than 262144 bytes (256 KiB) and duplicate app IDs, bundle IDs, helper commands or tool IDs, which this schema cannot express (packages/catalog/README.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "apps", "tools"],
  "properties": {
    "schema": { "const": "subset.catalog@1" },
    "generatedAt": { "$ref": "#/$defs/utcTimestamp" },
    "apps": { "type": "array", "items": { "$ref": "#/$defs/app" } },
    "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } }
  },
  "$defs": {
    "utcTimestamp": {
      "description": "A UTC time to the second on a real calendar date (no February 30, February 29 only in a leap year), such as 2026-11-12T00:00:00Z.",
      "type": "string",
      "pattern": "^(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))|(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "id": {
      "description": "A catalog ID, such as point-in-time.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dmgUrl": {
      "description": "A DMG attached to a 21nCo/subset GitHub release. Path segments are plain: no percent-escapes, query, fragment, backslash, or . and .. segments, so the URL cannot resolve anywhere else.",
      "type": "string",
      "maxLength": 512,
      "pattern": "^https://github\\.com/21nCo/subset/releases/download/(?:(?!\\.\\.?/)[A-Za-z0-9._+-]+/)+[A-Za-z0-9._+-]+\\.dmg$"
    },
    "releaseUrl": {
      "description": "The 21nCo/subset GitHub release page of the build.",
      "type": "string",
      "maxLength": 512,
      "pattern": "^https://github\\.com/21nCo/subset/releases/tag/(?:(?!\\.\\.?/)[A-Za-z0-9._+-]+/)*(?!\\.\\.?$)[A-Za-z0-9._+-]+$"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "appName", "bundleId", "helpers", "channels"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "appName": {
          "description": "The app bundle's name without .app, as installed in /Applications.",
          "type": "string",
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*$"
        },
        "bundleId": {
          "description": "The app's CFBundleIdentifier.",
          "type": "string",
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$"
        },
        "helpers": { "type": "array", "items": { "$ref": "#/$defs/helper" } },
        "channels": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "live": { "$ref": "#/$defs/liveChannel" },
            "beta": { "$ref": "#/$defs/betaChannel" }
          }
        }
      }
    },
    "helper": {
      "description": "A command bundled in the app: `subset <command>` runs the file at path inside the installed app.",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "path", "kind"],
      "properties": {
        "command": { "$ref": "#/$defs/id" },
        "path": {
          "description": "Relative to the .app, inside its Contents/ folder, with no . or .. segments.",
          "type": "string",
          "maxLength": 255,
          "pattern": "^Contents(?:/(?!\\.\\.?(?:/|$))[A-Za-z0-9._-]+)+$"
        },
        "kind": { "enum": ["native", "node"] }
      },
      "if": { "properties": { "kind": { "const": "node" } } },
      "then": { "properties": { "path": { "type": "string", "pattern": "\\.mjs$" } } }
    },
    "liveChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "url", "sha256", "releaseUrl"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "url": { "$ref": "#/$defs/dmgUrl" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "releaseUrl": { "$ref": "#/$defs/releaseUrl" }
      }
    },
    "betaChannel": {
      "description": "Beta build `build` of `version`: the app's CFBundleShortVersionString is version and its CFBundleVersion is build.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "build", "url", "sha256", "releaseUrl"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "build": { "type": "integer", "minimum": 1, "maximum": 999999999 },
        "url": { "$ref": "#/$defs/dmgUrl" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "releaseUrl": { "$ref": "#/$defs/releaseUrl" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "package", "bin", "distTags"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "package": { "type": "string", "maxLength": 214, "pattern": "^@subset\\.dev/[a-z0-9][a-z0-9.-]*$" },
        "bin": { "type": "string", "maxLength": 100, "pattern": "^subset-[a-z0-9][a-z0-9-]*$" },
        "distTags": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "latest": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
            "beta": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+-beta\\.[1-9]\\d{0,8}$" }
          }
        }
      }
    }
  }
}
