{
  "name": "@subset.dev/timer",
  "version": "0.1.0",
  "description": "Multi-timers and interval workouts from the command line, with sound, notifications and an agent skill",
  "license": "MIT",
  "private": false,
  "type": "module",
  "bin": {
    "subset-timer": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "web",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/subset.git",
    "directory": "packages/timer-cli"
  },
  "homepage": "https://github.com/21nCo/subset/tree/main/packages/timer-cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test --test-timeout=60000 test/daemon/*.test.mjs test/cli/*.test.mjs test/serve.test.mjs test/mcp/*.test.mjs",
    "prepack": "node scripts/build.mjs && node scripts/build.mjs --check"
  },
  "devDependencies": {
    "@mcpfn/core": "0.0.5",
    "@mcpfn/testing": "0.0.5",
    "@subset/timer": "*",
    "rolldown": "1.2.11"
  }
}
