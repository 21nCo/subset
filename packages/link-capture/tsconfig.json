{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Web-standard globals only: no @types/node, so a Node built-in fails the type check.
    "lib": ["ES2022", "DOM"],
    "types": [],
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/*.ts"]
}
