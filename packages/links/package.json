{
  "name": "@subset.dev/links",
  "private": false,
  "version": "0.1.0",
  "description": "Canonical URLs and link details (title, description, image, icons) from a URL and its HTML, on any JavaScript runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/subset.git",
    "directory": "packages/links"
  },
  "homepage": "https://github.com/21nCo/subset/tree/main/packages/links#readme",
  "bugs": {
    "url": "https://github.com/21nCo/subset/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "htmlparser2": "12.0.0"
  },
  "devDependencies": {
    "rolldown": "1.2.11",
    "typescript": "^5.9.3",
    "workerd": "1.20261028.1"
  }
}
