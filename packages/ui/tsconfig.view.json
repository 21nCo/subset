{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "svelte"
    ],
    "verbatimModuleSyntax": true,
    "rootDir": ".",
    "declaration": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "gallery/**/*.ts",
    "gallery/**/*.svelte"
  ]
}
