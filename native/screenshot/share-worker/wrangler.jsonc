{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "subset-screenshot-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  // No custom domain or route is configured. Add one only when a deployment is authorized.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "subset-screenshot-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "subset-screenshot-share",
      // Replace with the ID printed by `wrangler d1 create subset-screenshot-share`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
