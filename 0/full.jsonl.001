providerMeta[profile.provider].name}{account?.email && account.email !== nameOf(profile) ? ` · ${account.email}` : ''}{profile.collector ? ` · Collector ${profile.collector.state === 'installed' ? 'installed' : profile.collector.state === 'manual' ? 'set up manually' : 'not installed'}` : ''}</span>\n743:            {#if collector?.state === 'installed'}\n750:            {:else if collector && ['not-installed', 'replaced'].includes(collector.state)}\n751:              <div class={`state ${collector.state === 'replaced' ? 'warn' : ''}`}>\n754:                  <strong>{collector.state === 'replaced' ? 'Replaced by another tool' : 'Not installed'}</strong>\n755:                  <p>{collector.state === 'replaced' ? 'Something rewrote the status line in ' : 'Adds the collector to '}<code>{collector.settingsFile}</code>. A backup is saved as <code>settings.json.subset-backup</code>{collector.existing ? ', and your current status line keeps rendering' : ''}. Uninstalling or removing this account restores it.</p>\n757:                <button type=\"button\" class=\"btn small primary\" disabled={installing === selectedProfile.id} onclick={() => installCollector(selectedProfile.id)}>{installing === selectedProfile.id ? 'Installing…' : collector.state === 'replaced' ? 'Reinstall' : 'Install'}</button>\n759:            {:else if collector?.state === 'missing-directory'}\n761:            {:else if collector?.state === 'unreadable'}\n766:            <details open={collector?.state === 'manual' || collector?.state === 'unreadable'}>","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"d1a878a7-8642-405e-8f19-e5af1d5c249e","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ccf55d8d-6176-4456-a8a3-555947c35bfe","userType":"external","entrypoint":"cli","cwd":"/Users/serro/Documents/dev/n/subset","sessionId":"ccf55d8d-6176-4456-a8a3-555947c35bfe","version":"2.1.294","gitBranch":"main","slug"