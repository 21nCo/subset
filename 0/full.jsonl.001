 install and build from the root.","+      - name: Install workspace dependencies","+        run: npm ci","+","+      - name: Check workspaces","+        run: npm run check","+","+      - name: Build workspaces","+        run: npm run build","+","+      - name: Test package","+        run: npm test --workspace=${{ steps.resolve.outputs.pkg_name }}","+","+      - name: Pack package","+        working-directory: ${{ steps.resolve.outputs.pkg_path }}","+        run: npm pack --json","+","+      - name: Publish package","+        working-directory: ${{ steps.resolve.outputs.pkg_path }}","+        run: npm publish --access public","+        env:","+          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}"]}],"created":true},{"filePath":"/Users/serro/Documents/dev/n/subset/scripts/resolve-release-tag.mjs","hunks":[{"oldStart":1,"oldLines":3,"newStart":1,"newLines":5,"lines":["+// Resolves a <slug>-v<version> release tag to one publishable workspace (modelled on the","+// Superfunctions publish-tag workflow). Fails unless name, version, and public status match."," import { appendFile, readFile } from 'node:fs/promises';"," import path from 'node:path';"," import process from 'node:process';"]},{"oldStart":78,"oldLines":6,"newStart":80,"newLines":10,"lines":["   );"," }"," ","+if (packageJson.private !== false) {","+  fail(`${target.name} at ${target.path} is not marked private: false, so it is not ready to publish`);","+}","+"," if (packageJson.version !== version) {","   fail(`Tag version ${version} does not match ${target.name}@${packageJson.version} in ${target.path}/package.json`);"," }"]}]}],"moreFiles":0,"changedFiles":["/Users/serro/Documents/dev/n/subset/.github/workflows/publish-tag.yml","/Users/serro/Documents/dev/n/subset/scripts/resolve-release-tag.mjs"]}},"sourceToolAssistantUUID":"61d35125-617f-4b19-978f-58a4b37129ee","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ccf55d8d-6176-4456-a8a3-555947c35bfe","userType":"ext