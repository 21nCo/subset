ch; display: grid; place-items: center; }","-  /* Each segment spans its row including padding, so consecutive segments meet. */","-  .rail::before { content: ''; position: absolute; left: 50%; top: -8px; bottom: -8px; width: 2px; transform: translateX(-50%); background: var(--line-strong); }","-  .reset-row:first-child .rail::before { top: 50%; }","-  .reset-row:last-child .rail::before { bottom: 50%; }","-  .reset-row:only-child .rail::before { display: none; }","+  .rail { position: relative; z-index: 1; align-self: stretch; display: grid; place-items: center; }","+  .summary dd.resets-dd { position: relative; }","+  .timeline-line { position: absolute; width: 2px; background: var(--line-strong); margin: 0 !important; pointer-events: none; }","   .rail i { position: relative; width: 10px; height: 10px; border-radius: 50%; background: var(--surface); border: 2px solid var(--accent); }","   .reset-row:first-child .rail i { background: var(--accent); }","   .summary dd .reset-text time { font-weight: 600; color: var(--text); }"]}]}],"moreFiles":0,"changedFiles":["/Users/serro/Documents/dev/n/subset/packages/usage/src/UsageDashboard.svelte"]}},"sourceToolAssistantUUID":"3b11a3dc-64ec-40a3-8ac3-d9a97c5f2c95","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ccf55d8d-6176-4456-a8a3-555947c35bfe","userType":"external","entrypoint":"cli","cwd":"/Users/serro/Documents/dev/n/subset","sessionId":"ccf55d8d-6176-4456-a8a3-555947c35bfe","version":"2.1.294","gitBranch":"main"}
