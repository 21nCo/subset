2:36.071Z","session_id":"ccf55d8d-6176-4456-a8a3-555947c35bfe","userType":"external","entrypoint":"cli","cwd":"/Users/serro/Documents/dev/n/subset","sessionId":"ccf55d8d-6176-4456-a8a3-555947c35bfe","version":"2.1.294","gitBranch":"main"}
{"parentUuid":"e6cd6b94-5cb8-45f7-ad85-90ff0b49ccb5","isSidechain":false,"promptId":"54454a4d-12b9-4ee3-b2a6-9023849a1ade","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XrZFdHiMz1nkKxn3oKMR5x","type":"tool_result","content":"    60\t  if (entry?.account && now - entry.at < minIntervalMs) return entry.account;\n    61\t  if (entry?.cooldownUntil > now) return entry.account ?? entry.error;\n    62\t  const result = await read();\n    63\t  const limited = result.errors?.some((error) => /rate_limited$/.test(error.code));\n    64\t  if (limited) {\n    65\t    liveCache.set(key, { ...entry, error: result, cooldownUntil: now + (result.retryAfterMs ?? 5 * 60_000) });\n    66\t    return entry?.account ?? result;\n    67\t  }\n    68\t  if (result.observedAt && ['ok', 'partial'].includes(result.state)) liveCache.set(key, { account: result, at: now });\n    69\t  else liveCache.delete(key);\n    70\t  return result;\n    71\t}\n    72\t// Readers attach retryAfterMs for the throttle; it is not part of the status contract.\n    73\tconst publicAccount = ({ retryAfterMs: _retry, ...account }) => account;\n    74\tconst needsLocalSignIns = (profile, tool) => ({\n    75\t  id: profile.id, label: profile.label, provider: profile.provider, source: `${tool} sign-in`, plan: null, observedAt: null, state: 'unauthorized', windows: [], resetCredits: null,\n    76\t  errors: [{ code: 'local_sign_ins_off', message: `Turn on local sign-ins in Settings to read ${tool}'s stored login.` }],\n    77\t});\n    78\t\n    79\tasync function status() {\n    80\t  // A missing or failed Claude CLI must not hide the other accounts.\n    81\t  await accounts.ensureDefaultClaude().catch(() => null);\n    82\t  const configured = await accounts.profiles();\n    83\t  const { localCredentials } = await accounts.usagePreferences();\n    84\t  const readOne = async (profile) => {\n    85\t    if (profile.provider === 'cursor') return readCursorProfile(profile);\n    86\t    if (profile.provider === 'factory-droid') return publicAccount(await throttled(`factory:${profile.id}:${localCredentials}`, 60_000, () => readFactoryProfile(profile, { localCredentials })));\n    87\t    if (profile.provider === 'cursor-local') {\n    88\t      if (!localCredentials) return needsLocalSignIns(profile, 'Cursor');\n    89\t      return publicAccount(await throttled(`cursor-local:${profile.id}`, 120_000, () => readCursorLocalProfile(profile)));\n    90\t    }\n    91\t    if (profile.provider === 'amp') return publicAccount(await throttled(`amp:${profile.id}`, 60_000, () => readAmpProfile(profile)));\n    92\t    if (profile.provider === 'devin') return publicAccount(await throttled(`devin:${profile.id}:${localCredentials}`, 60_000, () => readDevinProfile(profile, { localCredentials })));\n    93\t    if (['pi', 'opencode', 'omp', 'hermes'].includes(profile.provider)) {\n    94\t      if (!localCredentials) return needsLocalSignIns(profile, { pi: 'Pi', opencode: 'OpenCode', omp: 'omp', hermes: 'Hermes' }[profile.provider]);\n    95\t      return publicAccount(await throttled(`${profile.provider}:${profile.id}`, 120_000, () => readStoredLoginProfile(profile)));\n    96\t    }\n    97\t    if (profile.provider === 'claude-code' && profile.claudeConfigDir) {\n    98\t      // `claude auth status` runs first so Claude Code can refresh its own token before a live read.\n    99\t      const auth = await readClaudeAuthStatus(profile.claudeConfigDir, { defaultConfigDir: accounts.defaultClaudeConfigDir });\n   100\t      const snapshot = await readSnapshotProfile(profile);\n   101\t      if (!localCredentials || auth?.loggedIn === false) return withClaudeAuth(snapshot, auth);\n   102\t      const fallback = withClaudeAuth(snapshot, auth);\n   103\t      const live = await throttled(`claude:${profile.id}`, 300_000, async () => {\n   104\t        const result = await readClaudeOAuthUsage(profile, { isDefault: profile.claudeConfigDir === accounts.defaultClaudeConfigDir });\n   105\t        if (result.kind === 'ok') return result.account;\n   106\t        if (result.kind === 'no-credential') return { noCredential: true, errors: [] };\n   107\t        return { liveError: result, errors: [{ code: result.code, message: result.message }], retryAfterMs: result.retryAfterMs };\n   108\t      });\n   109\t      if (live.observedAt) return withClaudeAuth({ ...live, plan: live.plan ?? snapshot.plan }, auth);\n   110\t      if (live.noCredential) return fallback;\n   111\t      const failure = live.liveError;\n   112\t      // Keep any collected snapshot, and say why the live read failed.\n   113\t      return { ...fallback, state: fallback.windows.length ? fallback.state : failure.state,\n   114\t        errors: [{ code: failure.code, message: failure.message }, ...fallback.errors.filter((error) => error.code !== 'claude_awaiting_snapshot')] };\n   115\t    }\n   116\t    if (profile.provider === 'antigravity') {\n   117\t      // The status line carries no identity; with local sign-ins on, show the CLI's signed-in email.\n   118\t      const account = await readSnapshotProfile(profile);\n   119\t      const email = localCredentials ? await readAntigravityEmail() : null;\n   120\t      return email ? { ...account, email } : account;\n   121\t    }\n   122\t    if (profile.provider === 'claude-code') return readSnapshotProfile(profile);\n   123\t    return readCodexProfile(profile);\n   124\t  };\n   125\t\n   126\t  // One account signed in to several harnesses gets one card: the direct ChatGPT or Claude\n   127\t  // account (or the first harness) is read, and the others are listed in `alsoIn`. Another\n   128\t  // harness is read only as a fallback when the main read has no usage.\n   129\t  const harnessNames = { pi: 'Pi', opencode: 'OpenCode', omp: 'omp', hermes: 'Hermes' };\n   130\t  const isHarnessLogin = (profile) => Object.hasOwn(harnessNames, profile.provider) && (profile.login === 'chatgpt' || profile.login === 'claude');\n   131\t  const results = new Map();\n   132\t  await Promise.all(configured.filter((profile) => !isHarnessLogin(profile)).map(async (profile) => { results.set(profile.id, await readOne(profile)); }));\n   133\t  const owners = new Map();\n   134\t  for (const [id, account] of results) {\n   135\t    if ((account.provider === 'codex-chatgpt' || account.provider === 'claude-code') && account.email) owners.set(`${account.provider}|${account.email.toLowerCase()}`, id);\n   136\t  }\n   137\t  const merged = new Set();\n   138\t  for (const profile of configured.filter(isHarnessLogin)) {\n   139\t    const service = profile.login === 'chatgpt' ? 'codex-chatgpt' : 'claude-code';\n   140\t    const email = localCredentials ? await storedLoginEmail(profile).catch(() => null) : null;\n   141\t    const key = email ? `${service}|${email.toLowerCase()}` : null;\n   142\t    const ownerId = key ? owners.get(key) : undefined;\n   143\t    if (ownerId) {\n   144\t      const owner = results.get(ownerId);\n   145\t      if (!owner.windows.length || !['ok', 'partial'].includes(owner.state)) {\n   146\t        const fallback = await readOne(profile);\n   147\t        if (fallback.windows.length) {\n   148\t          results.set(ownerId, { ...owner, windows: fallback.windows, state: fallback.state, observedAt: fallback.observedAt, plan: owner.plan ?? fallback.plan,\n   149\t            source: `${owner.source}, read through ${harnessNames[profile.provider]}`, errors: [] });\n   150\t        }\n   151\t      }\n   152\t      const current = results.get(ownerId);\n   153\t      results.set(ownerId, { ...current, alsoIn: [...new Set([...(current.alsoIn ?? []), profile.provider])] });\n   154\t      merged.add(profile.id);\n   155\t      continue;\n   156\t    }\n   157\t    const account = await readOne(profile);\n   158\t    results.set(profile.id, account);\n   159\t    const ownKey = account.email ? `${service}|${account.email.toLowerCase()}` : key;\n   160\t    if (ownKey && account.windows.length) owners.set(ownKey, profile.id);\n   161\t  }\n   162\t  return createUsageStatus(configured.filter((profile) => !merged.has(profile.id)).map((profile) => results.get(profile.id)));\n   163\t}\n   164\t\n   165\tfunction runStatusLine(command, input) {\n   166\t  return new Promise((resolveExit) => {\n   167\t    const child = spawn('/bin/sh', ['-c', command], { stdio: ['pipe', 'inherit', 'inherit'] });\n   168\t    child.on('error', () => resolveExit(1));\n   169\t    child.on('close', (code) => resolveExit(code ?? 1));\n   170\t    child.stdin.on('error', () => {});\n   171\t    child.stdin.end(input);\n   172\t  });\n   173\t}\n   174\t\n   175\tconst shellQuote = (value) => `'${value.replaceAll(\"'\", \"'\\\\''\")}'`;\n   176\tconst defaultClaudeConfigDir = resolve(homedir(), '.claude');\n   177\tconst claudeSetup = (profile) => {\n   178\t  const command = collectCommand(profile.id);\n   179\t  const configDir = profile.claudeConfigDir;\n   180\t  return {\n   181\t    collectCommand: command,\n   182\t    ...(configDir ? {\n   183\t      claudeSettingsFile: resolve(configDir, 'settings.json'),\n   184\t      claudeLaunchCommand: configDir === defaultClaudeConfigDir ? 'claude' : `CLAUDE_CONFIG_DIR=${shellQuote(configDir)} claude`,\n   185\t    } : {}),\n   186\t  };\n   187\t};\n   188\tconst collectCommand = (id) => `${process.env.SUBSET_USAGE_PROFILES_FILE || process.env.SUBSET_CODEX_PROFILES_FILE ? `SUBSET_USAGE_PROFILES_FILE=${shellQuote(profilesFile)} ` : ''}${dataDirectory ? `SUBSET_USAGE_DATA_DIR=${shellQuote(dataDirectory)} ` : ''}node ${shellQuote(fileURLToPath(import.meta.url))} collect --account ${shellQuote(id)}`;\n   189\t\n   190\tasync function readJson(request) {\n   191\t  if (!request.headers['content-type']?.startsWith('application/json')) throw new Error('Expected a JSON request.');\n   192\t  const chunks = [];\n   193\t  let bytes = 0;\n   194\t  for await (const chunk of request) {\n   195\t    bytes += chunk.length;\n   196\t    if (bytes > 8192) throw new Error('Request is too large.');\n   197\t    chunks.push(chunk);\n   198\t  }\n   199\t  try { return JSON.parse(Buffer.concat(chunks).toString('utf8')); }\n   200\t  catch { throw new Error('Invalid JSON request.'); }\n   201\t}\n   202\t\n   203\tfunction json(response, code, value) {\n   204\t  response.setHeader('Content-Type', 'application/json; charset=utf-8');\n   205\t  response.writeHead(code).end(JSON.stringify(value));\n   206\t}\n   207\t\n   208\tconst publicErrors = new Set([\n   209\t  'Expected a JSON request.', 'Request is too large.', 'Invalid JSON request.',\n   210\t  'The current Codex home is not signed in with a ChatGPT account.', 'The dashboard already has 20 accounts.',\n   211\t  'Enter an account name of at most 80 characters.', 'Finish or cancel the current sign-in first.',\n   212\t  'Invalid account ID.', 'Account was not found.', 'Sign-in was not found.', 'No active sign-in was found.',\n   213\t  'Could not start ChatGPT sign-in.', 'Could not read Codex profiles configuration.',\n   214\t  'Invalid Codex profile configuration.', 'Duplicate Codex profile configuration.',\n   215\t  'Codex profiles configuration must contain at most 20 profiles.',\n   216\t  'Could not read usage profiles configuration.', 'Invalid usage profile configuration.',\n   217\t  'Duplicate usage profile configuration.', 'Usage profiles configuration must contain at most 20 profiles.',\n   218\t  'Unsupported usage provider.', 'Invalid usage account configuration.',\n   219\t  'Enter the Claude Code config directory as an absolute or ~/ path.',\n   220\t  'Another Claude Code account already uses this config directory.',\n   221\t  'The default Claude Code config directory is not signed in.',\n   222\t  'Could not read the CLI settings file.', 'The CLI settings file is too large to update safely.',\n   223\t  'The CLI settings file is not valid JSON. Fix it or set up the collector manually.',\n   224\t  'Set a Claude Code config directory for this account to install its collector automatically.',\n   225\t  'The CLI settings directory was not found. Start the CLI once with this account, then try again.',\n   226\t  'Could not back up the CLI settings file.',\n   227\t  'Enter the Factory home as an absolute or ~/ path.', 'Invalid settings.',\n   228\t  'Choose which stored login to read.', 'Invalid reset request.', 'Codex could not use a reset.',\n   229\t]);\n   230\t\n   231\tconst command = process.argv[2] ?? 'serve';\n   232\tif (command === 'status') {\n   233\t  try { process.stdout.write(`${JSON.stringify(await status())}\\n`); }\n   234\t  catch { process.stderr.write('Could not read usage configuration.\\n'); process.exitCode = 1; }\n   235\t} else if (command === 'collect') {\n   236\t  const id = process.argv.length === 5 && process.argv[3] === '--account' ? process.argv[4] : null;\n   237\t  const chunks = [];\n   238\t  let bytes = 0;\n   239\t  for await (const chunk of process.stdin) {\n   240\t    bytes += chunk.length;\n   241\t    if (bytes > 1024 * 1024) break;\n   242\t    chunks.push(chunk);\n   243\t  }\n   244\t  const input = Buffer.concat(chunks);\n   245\t  // An installed collector replaces the CLI's status line, so it runs the previous one with the same input.\n   246\t  const chained = id ? await accounts.chainedStatusLine(id).catch(() => null) : null;\n   247\t  const previous = chained ? runStatusLine(chained, input) : null;\n   248\t  try {\n   249\t    if (!id) throw new Error('Invalid collector arguments.');\n   250\t    if (input.length > 65536) throw new Error('Snapshot is too large.');\n   251\t    await accounts.captureSnapshot(id, JSON.parse(input.toString('utf8')), { env: process.env });\n   252\t  } catch (error) {\n   253\t    // Startup payloads arrive before quota exists; stay quiet while the previous status line renders.\n   254\t    if (!previous) {\n   255\t      process.stderr.write(/different Claude Code config directory/.test(error?.message ?? '')\n   256\t        ? `${error.message} Check which settings.json contains this collector.\\n`\n   257\t        : 'Could not collect this account quota snapshot. Check the account ID and CLI payload.\\n');\n   258\t      process.exitCode = 1;\n   259\t    }\n   260\t  }\n   261\t  if (previous) process.exitCode = await previous;\n   262\t} else if (command === 'serve') {\n   263\t  const port = Number(process.env.SUBSET_USAGE_PORT ?? 4174);\n   264\t  if (!Number.isInteger(port) || port < 1 || port > 65535) throw new Error('Invalid port.');\n   265\t  const mime = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript; charset=utf-8', '.css': 'text/css; charset=utf-8', '.svg': 'image/svg+xml', '.woff2': 'font/woff2' };\n   266\t  const server = createServer(async (request, response) => {\n   267\t    const host = request.headers.host;\n   268\t    if (host !== `127.0.0.1:${port}` && host !== `localhost:${port}`) { response.writeHead(403).end(); return; }\n   269\t    const origin = request.headers.origin;\n   270\t    if (origin && origin !== `http://${host}`) { response.writeHead(403).end(); return; }\n   271\t    const path = new URL(request.url ?? '/', `http://${host}`).pathname;\n   272\t    response.setHeader('Cache-Control', 'no-store');\n   273\t    response.setHeader('X-Content-Type-Options', 'nosniff');\n   274\t    response.setHeader('Content-Security-Policy', \"default-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'self' http://127.0.0.1:* http://localhost:*\");\n   275\t    try {\n   276\t      if (path === '/api/status' && request.method === 'GET') {\n   277\t        const current = await status();\n   278\t        await recordHistory(current);\n   279\t        json(response, 200, current); return;\n   280\t      }\n   281\t      if (path === '/api/stored-logins' && request.method === 'GET') {\n   282\t        // Names of the logins Pi and OpenCode hold, never their values.\n   283\t        const [pi, opencode, omp, hermes] = await Promise.all(['pi', 'opencode', 'omp', 'hermes'].map((tool) => listStoredLogins(tool)));\n   284\t        json(response, 200, { pi, opencode, omp, hermes }); return;\n   285\t      }\n   286\t      if (path === '/api/preferences' && request.method === 'GET') { json(response, 200, await accounts.usagePreferences()); return; }\n   287\t      if (path === '/api/history' && request.method === 'GET') { json(response, 200, await loadHistory()); return; }\n   288\t      if (path === '/api/profiles' && request.method === 'GET') {\n   289\t        await accounts.ensureDefaultClaude().catch(() => null);\n   290\t        const profiles = await Promise.all((await accounts.list()).map(async (profile) => {\n   291\t          if (profile.provider === 'factory-droid') {\n   292\t            return { ...profile, factoryLaunchCommand: profile.factoryHome === homedir() ? 'droid' : `FACTORY_HOME_OVERRIDE=${shellQuote(profile.factoryHome)} droid` };\n   293\t          }\n   294\t          if (profile.provider !== 'claude-code' && profile.provider !== 'antigravity') return profile;\n   295\t          const command = collectCommand(profile.id);\n   296\t          return { ...profile, ...(profile.provider === 'claude-code' ? claudeSetup(profile) : { collectCommand: command }),\n   297\t            collector: await accounts.collectorStatus(profile, command) };\n   298\t        }));\n   299\t        json(response, 200, { profiles }); return;\n   300\t      }\n   301\t      if (path.startsWith('/api/')) {\n   302\t        if (request.method !== 'GET' && request.headers.origin !== `http://${host}`) { response.writeHead(403).end(); return; }\n   303\t        if (path === '/api/profiles' && request.method === 'POST') {\n   304\t          const body = await readJson(request);\n   305\t          json(response, 201, await accounts.addProvider(body)); return;\n   306\t        }\n   307\t        if (path === '/api/profiles/current' && request.method === 'POST') { json(response, 201, await accounts.addCurrent()); return; }\n   308\t        if (path === '/api/profiles/claude-default' && request.method === 'POST') { json(response, 201, await accounts.ensureDefaultClaude({ force: true })); return; }\n   309\t        if (path === '/api/preferences' && request.method === 'PUT') { json(response, 200, await accounts.setUsagePreferences(await readJson(request))); return; }\n   310\t        if (path === '/api/history' && request.method === 'DELETE') {\n   311\t          historyQueue = historyQueue.then(() => rm(historyFile, { force: true })).catch(() => {});\n   312\t          await historyQueue;\n   313\t          json(response, 200, { cleared: true }); return;\n   314\t        }\n   315\t        const resetMatch = path.match(/^\\/api\\/profiles\\/([a-zA-Z0-9_-]{1,64})\\/reset$/);\n   316\t        if (resetMatch && request.method === 'POST') {\n   317\t          const body = await readJson(request);\n   318\t          if (typeof body?.idempotencyKey !== 'string' || !/^[0-9a-f-]{36}$/i.test(body.idempotencyKey)) throw new Error('Invalid reset request.');\n   319\t          const profile = (await accounts.profiles()).find((item) => item.id === resetMatch[1] && item.provider === 'codex-chatgpt');\n   320\t          if (!profile) throw new Error('Account was not found.');\n   321\t          try { json(response, 200, { outcome: await consumeCodexResetCredit(profile, { idempotencyKey: body.idempotencyKey }) }); }\n   322\t          catch { throw new Error('Codex could not use a reset.'); }\n   323\t          return;\n   324\t        }\n   325\t        const collectorMatch = path.match(/^\\/api\\/profiles\\/([a-zA-Z0-9_-]{1,64})\\/collector$/);\n   326\t        if (collectorMatch && request.method === 'POST') { json(response, 200, await accounts.installCollector(collectorMatch[1], collectCommand(collectorMatch[1]))); return; }\n   327\t        if (collectorMatch && request.method === 'DELETE') { json(response, 200, await accounts.uninstallCollector(collectorMatch[1])); return; }\n   328\t        const profileMatch = path.match(/^\\/api\\/profiles\\/([a-zA-Z0-9_-]{1,64})$/);\n   329\t        if (profileMatch && request.method === 'PATCH') {\n   330\t          const body = await readJson(request);\n   331\t          if (!body || typeof body !== 'object' || Object.keys(body).some((key) => key !== 'label')) throw new Error('Invalid usage account configuration.');\n   332\t          json(response, 200, await accounts.renameProfile(profileMatch[1], body.label ?? '')); return;\n   333\t        }\n   334\t        if (profileMatch && request.method === 'DELETE') {\n   335\t          const body = await readJson(request);\n   336\t          if (body?.confirmation !== profileMatch[1]) throw new Error('Invalid account ID.');\n   337\t          json(response, 200, await accounts.removeProfile(profileMatch[1])); return;\n   338\t        }\n   339\t        if (path === '/api/connections' && request.method === 'POST') {\n   340\t          const body = await readJson(request);\n   341\t          json(response, 201, await accounts.startLogin(body?.label)); return;\n   342\t        }\n   343\t        if (path === '/api/connections/active' && request.method === 'GET') { json(response, 200, { connection: accounts.activeConnection() }); return; }\n   344\t        const connectionMatch = path.match(/^\\/api\\/connections\\/([a-zA-Z0-9_-]{1,64})$/);\n   345\t        if (connectionMatch && request.method === 'GET') { json(response, 200, accounts.connection(connectionMatch[1])); return; }\n   346\t        const cancelMatch = path.match(/^\\/api\\/connections\\/([a-zA-Z0-9_-]{1,64})\\/cancel$/);\n   347\t        if (cancelMatch && request.method === 'POST') { json(response, 200, await accounts.cancelLogin(cancelMatch[1])); return; }\n   348\t        response.writeHead(404).end(); return;\n   349\t      }\n   350\t      if (request.method !== 'GET') { response.writeHead(405).end(); return; }\n   351\t    } catch (error) {\n   352\t      json(response, 400, { error: publicErrors.has(error?.message) ? error.message : 'Could not update usage accounts. Check the connection configuration.' });\n   353\t      return;\n   354\t    }\n   355\t    const target = resolve(dist, `.${path === '/' ? '/index.html' : path}`);\n   356\t    if (target !== dist && !target.startsWith(dist + sep)) { response.writeHead(404).end(); return; }\n   357\t    try { const body = await readFile(target); response.setHeader('Content-Type', mime[extname(target)] ?? 'application/octet-stream'); response.writeHead(200).end(body); }\n   358\t    catch { response.writeHead(404).end(); }\n   359\t  });\n   360\t  server.listen(port, '127.0.0.1', () => process.stdout.write(`Subset usage listening on http://127.0.0.1:${port}\\n`));\n   361\t  let stopping = false;\n   362\t  for (const signal of ['SIGINT', 'SIGTERM']) process.on(signal, () => {\n   363\t    if (stopping) process.exit(1);\n   364\t    stopping = true;\n   365\t    // Browser keep-alive connections would otherwise hold the process open after Ctrl-C.\n   366\t    server.close();\n   367\t    server.closeAllConnections();\n   368\t    setTimeout(() => process.exit(1), 5000).unref();\n   369\t    void accounts.close().finally(() => process.exit(0));\n   370\t  });\n   371\t} else {\n   372\t  process.stderr.write('Usage: node server.mjs [status|serve|collect --account <id>]\\n');\n   373\t  process.exitCode = 2;\n   374\t}","is_error":false}]},"uuid":"e26dda85-6e9a-4d32-982c-786b9239f1a3","timestamp":"2026-10-08T13:12:36.187Z","toolUseResult":{"stdout":"    60\t  if (entry?.account && now - entry.at < minIntervalMs) return entry.account;\n    61\t  if (entry?.cooldownUntil > now) return entry.account ?? entry.error;\n    62\t  const result = await read();\n    63\t  const limited = result.errors?.some((error) => /rate_limited$/.test(error.code));\n    64\t  if (limited) {\n    65\t    liveCache.set(key, { ...entry, error: result, cooldownUntil: now + (result.retryAfterMs ?? 5 * 60_000) });\n    66\t    return entry?.account ?? result;\n    67\t  }\n    68\t  if (result.observedAt && ['ok', 'partial'].includes(result.state)) liveCache.set(key, { account: result, at: now });\n    69\t  else liveCache.delete(key);\n    70\t  return result;\n    71\t}\n    72\t// Readers attach retryAfterMs for the throttle; it is not part of the status contract.\n    73\tconst publicAccount = ({ retryAfterMs: _retry, ...account }) => account;\n    74\tconst needsLocalSignIns = (profile, tool) => ({\n    75\t  id: profile.id, label: profile.label, provider: profile.provider, source: `${tool} sign-in`, plan: null, observedAt: null, state: 'unauthorized', windows: [], resetCredits: null,\n    76\t  errors: [{ code: 'local_sign_ins_off', message: `Turn on local sign-ins in Settings to read ${tool}'s stored login.` }],\n    77\t});\n    78\t\n    79\tasync function status() {\n    80\t  // A missing or failed Claude CLI must not hide the other accounts.\n    81\t  await accounts.ensureDefaultClaude().catch(() => null);\n    82\t  const configured = await accounts.profiles();\n    83\t  const { localCredentials } = await accounts.usagePreferences();\n    84\t  const readOne = async (profile) => {\n    85\t    if (profile.provider === 'cursor') return readCursorProfile(profile);\n    86\t    if (profile.provider === 'factory-droid') return publicAccount(await throttled(`factory:${profile.id}:${localCredentials}`, 60_000, () => readFactoryProfile(profile, { localCredentials })));\n    87\t    if (profile.provider === 'cursor-local') {\n    88\t      if (!localCredentials) return needsLocalSignIns(profile, 'Cursor');\n    89\t      return publicAccount(await throttled(`cursor-local:${profile.id}`, 120_000, () => readCursorLocalProfile(profile)));\n    90\t    }\n    91\t    if (profile.provider === 'amp') return publicAccount(await throttled(`amp:${profile.id}`, 60_000, () => readAmpProfile(profile)));\n    92\t    if (profile.provider === 'devin') return publicAccount(await throttled(`devin:${profile.id}:${localCredentials}`, 60_000, () => readDevinProfile(profile, { localCredentials })));\n    93\t    if (['pi', 'opencode', 'omp', 'hermes'].includes(profile.provider)) {\n    94\t      if (!localCredentials) return needsLocalSignIns(profile, { pi: 'Pi', opencode: 'OpenCode', omp: 'omp', hermes: 'Hermes' }[profile.provider]);\n    95\t      return publicAccount(await throttled(`${profile.provider}:${profile.id}`, 120_000, () => readStoredLoginProfile(profile)));\n    96\t    }\n    97\t    if (profile.provider === 'claude-code' && profile.claudeConfigDir) {\n    98\t      // `claude auth status` runs first so Claude Code can refresh its own token before a live read.\n    99\t      const auth = await readClaudeAuthStatus(profile.claudeConfigDir, { defaultConfigDir: accounts.defaultClaudeConfigDir });\n   100\t      const snapshot = await readSnapshotProfile(profile);\n   101\t      if (!localCredentials || auth?.loggedIn === false) return withClaudeAuth(snapshot, auth);\n   102\t      const fallback = withClaudeAuth(snapshot, auth);\n   103\t      const live = await throttled(`claude:${profile.id}`, 300_000, async () => {\n   104\t        const result = await readClaudeOAuthUsage(profile, { isDefault: profile.claudeConfigDir === accounts.defaultClaudeConfigDir });\n   105\t        if (result.kind === 'ok') return result.account;\n   106\t        if (result.kind === 'no-credential') return { noCredential: true, errors: [] };\n   107\t        return { liveError: result, errors: [{ code: result.code, message: result.message }], retryAfterMs: result.retryAfterMs };\n   108\t      });\n   109\t      if (live.observedAt) return withClaudeAuth({ ...live, plan: live.plan ?? snapshot.plan }, auth);\n   110\t      if (live.noCredential) return fallback;\n   111\t      const failure = live.liveError;\n   112\t      // Keep any collected snapshot, and say why the live read failed.\n   113\t      return { ...fallback, state: fallback.windows.length ? fallback.state : failure.state,\n   114\t        errors: [{ code: failure.code, message: failure.message }, ...fallback.errors.filter((error) => error.code !== 'claude_awaiting_snapshot')] };\n   115\t    }\n   116\t    if (profile.provider === 'antigravity') {\n   117\t      // The status line carries no identity; with local sign-ins on, show the CLI's signed-in email.\n   118\t      const account = await readSnapshotProfile(profile);\n   119\t      const email = localCredentials ? await readAntigravityEmail() : null;\n   120\t      return email ? { ...account, email } : account;\n   121\t    }\n   122\t    if (profile.provider === 'claude-code') return readSnapshotProfile(profile);\n   123\t    return readCodexProfile(profile);\n   124\t  };\n   125\t\n   126\t  // One account signed in to several harnesses gets one card: the direct ChatGPT or Claude\n   127\t  // account (or the first harness) is read, and the others are listed in `alsoIn`. Another\n   128\t  // harness is read only as a fallback when the main read has no usage.\n   129\t  const harnessNames = { pi: 'Pi', opencode: 'OpenCode', omp: 'omp', hermes: 'Hermes' };\n   130\t  const isHarnessLogin = (profile) => Object.hasOwn(harnessNames, profile.provider) && (profile.login === 'chatgpt' || profile.login === 'claude');\n   131\t  const results = new Map();\n   132\t  await Promise.all(configured.filter((profile) => !isHarnessLogin(profile)).map(async (profile) => { results.set(profile.id, await readOne(profile)); }));\n   133\t  const owners = new Map();\n   134\t  for (const [id, account] of results) {\n   135\t    if ((account.provider === 'codex-chatgpt' || account.provider === 'claude-code') && account.email) owners.set(`${account.provider}|${account.email.toLowerCase()}`, id);\n   136\t  }\n   137\t  const merged = new Set();\n   138\t  for (const profile of configured.filter(isHarnessLogin)) {\n   139\t    const service = profile.login === 'chatgpt' ? 'codex-chatgpt' : 'claude-code';\n   140\t    const email = localCredentials ? await storedLoginEmail(profile).catch(() => null) : null;\n   141\t    const key = email ? `${service}|${email.toLowerCase()}` : null;\n   142\t    const ownerId = key ? owners.get(key) : undefined;\n   143\t    if (ownerId) {\n   144\t      const owner = results.get(ownerId);\n   145\t      if (!owner.windows.length || !['ok', 'partial'].includes(owner.state)) {\n   146\t        const fallback = await readOne(profile);\n   147\t        if (fallback.windows.length) {\n   148\t          results.set(ownerId, { ...owner, windows: fallback.windows, state: fallback.state, observedAt: fallback.observedAt, plan: owner.plan ?? fallback.plan,\n   149\t            source: `${owner.source}, read through ${harnessNames[profile.provider]}`, errors: [] });\n   150\t        }\n   151\t      }\n   152\t      const current = results.get(ownerId);\n   153\t      results.set(ownerId, { ...current, alsoIn: [...new Set([...(current.alsoIn ?? []), profile.provider])] });\n   154\t      merged.add(profile.id);\n   155\t      continue;\n   156\t    }\n   157\t    const account = await readOne(profile);\n   158\t    results.set(profile.id, account);\n   159\t    const ownKey = account.email ? `${service}|${account.email.toLowerCase()}` : key;\n   160\t    if (ownKey && account.windows.length) owners.set(ownKey, profile.id);\n   161\t  }\n   162\t  return createUsageStatus(configured.filter((profile) => !merged.has(profile.id)).map((profile) => results.get(profile.id)));\n   163\t}\n   164\t\n   165\tfunction runStatusLine(command, input) {\n   166\t  return new Promise((resolveExit) => {\n   167\t    const child = spawn('/bin/sh', ['-c', command], { stdio: ['pipe', 'inherit', 'inherit'] });\n   168\t    child.on('error', () => resolveExit(1));\n   169\t    child.on('close', (code) => resolveExit(code ?? 1));\n   170\t    child.stdin.on('error', () => {});\n   171\t    child.stdin.end(input);\n   172\t  });\n   173\t}\n   174\t\n   175\tconst shellQuote = (value) => `'${value.replaceAll(\"'\", \"'\\\\''\")}'`;\n   176\tconst defaultClaudeConfigDir = resolve(homedir(), '.claude');\n   177\tconst claudeSetup = (profile) => {\n   178\t  const command = collectCommand(profile.id);\n   179\t  const configDir = profile.claudeConfigDir;\n   180\t  return {\n   181\t    collectCommand: command,\n   182\t    ...(configDir ? {\n   183\t      claudeSettingsFile: resolve(configDir, 'settings.json'),\n   184\t      claudeLaunchCommand: configDir === defaultClaudeConfigDir ? 'claude' : `CLAUDE_CONFIG_DIR=${shellQuote(configDir)} claude`,\n   185\t    } : {}),\n   186\t  };\n   187\t};\n   188\tconst collectCommand = (id) => `${process.env.SUBSET_USAGE_PROFILES_FILE || process.env.SUBSET_CODEX_PROFILES_FILE ? `SUBSET_USAGE_PROFILES_FILE=${shellQuote(profilesFile)} ` : ''}${dataDirectory ? `SUBSET_USAGE_DATA_DIR=${shellQuote(dataDirectory)} ` : ''}node ${shellQuote(fileURLToPath(import.meta.url))} collect --account ${shellQuote(id)}`;\n   189\t\n   190\tasync function readJson(request) {\n   191\t  if (!request.headers['content-type']?.startsWith('application/json')) throw new Error('Expected a JSON request.');\n   192\t  const chunks = [];\n   193\t  let bytes = 0;\n   194\t  for await (const chunk of request) {\n   195\t    bytes += chunk.length;\n   196\t    if (bytes > 8192) throw new Error('Request is too large.');\n   197\t    chunks.push(chunk);\n   198\t  }\n   199\t  try { return JSON.parse(Buffer.concat(chunks).toString('utf8')); }\n   200\t  catch { throw new Error('Invalid JSON request.'); }\n   201\t}\n   202\t\n   203\tfunction json(response, code, value) {\n   204\t  response.setHeader('Content-Type', 'application/json; charset=utf-8');\n   205\t  response.writeHead(code).end(JSON.stringify(value));\n   206\t}\n   207\t\n   208\tconst publicErrors = new Set([\n   209\t  'Expected a JSON request.', 'Request is too large.', 'Invalid JSON request.',\n   210\t  'The current Codex home is not signed in with a ChatGPT account.', 'The dashboard already has 20 accounts.',\n   211\t  'Enter an account name of at most 80 characters.', 'Finish or cancel the current sign-in first.',\n   212\t  'Invalid account ID.', 'Account was not found.', 'Sign-in was not found.', 'No active sign-in was found.',\n   213\t  'Could not start ChatGPT sign-in.', 'Could not read Codex profiles configuration.',\n   214\t  'Invalid Codex profile configuration.', 'Duplicate Codex profile configuration.',\n   215\t  'Codex profiles configuration must contain at most 20 profiles.',\n   216\t  'Could not read usage profiles configuration.', 'Invalid usage profile configuration.',\n   217\t  'Duplicate usage profile configuration.', 'Usage profiles configuration must contain at most 20 profiles.',\n   218\t  'Unsupported usage provider.', 'Invalid usage account configuration.',\n   219\t  'Enter the Claude Code config directory as an absolute or ~/ path.',\n   220\t  'Another Claude Code account already uses this config directory.',\n   221\t  'The default Claude Code config directory is not signed in.',\n   222\t  'Could not read the CLI settings file.', 'The CLI settings file is too large to update safely.',\n   223\t  'The CLI settings file is not valid JSON. Fix it or set up the collector manually.',\n   224\t  'Set a Claude Code config directory for this account to install its collector automatically.',\n   225\t  'The CLI settings directory was not found. Start the CLI once with this account, then try again.',\n   226\t  'Could not back up the CLI settings file.',\n   227\t  'Enter the Factory home as an absolute or ~/ path.', 'Invalid settings.',\n   228\t  'Choose which stored login to read.', 'Invalid reset request.', 'Codex could not use a reset.',\n   229\t]);\n   230\t\n   231\tconst command = process.argv[2] ?? 'serve';\n   232\tif (command === 'status') {\n   233\t  try { process.stdout.write(`${JSON.stringify(await status())}\\n`); }\n   234\t  catch { process.stderr.write('Could not read usage configuration.\\n'); process.exitCode = 1; }\n   235\t} else if (command === 'collect') {\n   236\t  const id = process.argv.length === 5 && process.argv[3] === '--account' ? process.argv[4] : null;\n   237\t  const chunks = [];\n   238\t  let bytes = 0;\n   239\t  for await (const chunk of process.stdin) {\n   240\t    bytes += chunk.length;\n   241\t    if (bytes > 1024 * 1024) break;\n   242\t    chunks.push(chunk);\n   243\t  }\n   244\t  const input = Buffer.concat(chunks);\n   245\t  // An installed collector replaces the CLI's status line, so it runs the previous one with the same input.\n   246\t  const chained = id ? await accounts.chainedStatusLine(id).catch(() => null) : null;\n   247\t  const previous = chained ? runStatusLine(chained, input) : null;\n   248\t  try {\n   249\t    if (!id) throw new Error('Invalid collector arguments.');\n   250\t    if (input.length > 65536) throw new Error('Snapshot is too large.');\n   251\t    await accounts.captureSnapshot(id, JSON.parse(input.toString('utf8')), { env: process.env });\n   252\t  } catch (error) {\n   253\t    // Startup payloads arrive before quota exists; stay quiet while the previous status line renders.\n   254\t    if (!previous) {\n   255\t      process.stderr.write(/different Claude Code config directory/.test(error?.message ?? '')\n   256\t        ? `${error.message} Check which settings.json contains this collector.\\n`\n   257\t        : 'Could not collect this account quota snapshot. Check the account ID and CLI payload.\\n');\n   258\t      process.exitCode = 1;\n   259\t    }\n   260\t  }\n   261\t  if (previous) process.exitCode = await previous;\n   262\t} else if (command === 'serve') {\n   263\t  const port = Number(process.env.SUBSET_USAGE_PORT ?? 4174);\n   264\t  if (!Number.isInteger(port) || port < 1 || port > 65535) throw new Error('Invalid port.');\n   265\t  const mime = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript; charset=utf-8', '.css': 'text/css; charset=utf-8', '.svg': 'image/svg+xml', '.woff2': 'font/woff2' };\n   266\t  const server = createServer(async (request, response) => {\n   267\t    const host = request.headers.host;\n   268\t    if (host !== `127.0.0.1:${port}` && host !== `localhost:${port}`) { response.writeHead(403).end(); return; }\n   269\t    const origin = request.headers.origin;\n   270\t    if (origin && origin !== `http://${host}`) { response.writeHead(403).end(); return; }\n   271\t    const path = new URL(request.url ?? '/', `http://${host}`).pathname;\n   272\t    response.setHeader('Cache-Control', 'no-store');\n   273\t    response.setHeader('X-Content-Type-Options', 'nosniff');\n   274\t    response.setHeader('Content-Security-Policy', \"default-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'self' http://127.0.0.1:* http://localhost:*\");\n   275\t    try {\n   276\t      if (path === '/api/status' && request.method === 'GET') {\n   277\t        const current = await status();\n   278\t        await recordHistory(current);\n   279\t        json(response, 200, current); return;\n   280\t      }\n   281\t      if (path === '/api/stored-logins' && request.method === 'GET') {\n   282\t        // Names of the logins Pi and OpenCode hold, never their values.\n   283\t        const [pi, opencode, omp, hermes] = await Promise.all(['pi', 'opencode', 'omp', 'hermes'].map((tool) => listStoredLogins(tool)));\n   284\t        json(response, 200, { pi, opencode, omp, hermes }); return;\n   285\t      }\n   286\t      if (path === '/api/preferences' && request.method === 'GET') { json(response, 200, await accounts.usagePreferences()); return; }\n   287\t      if (path === '/api/history' && request.method === 'GET') { json(response, 200, await loadHistory()); return; }\n   288\t      if (path === '/api/profiles' && request.method === 'GET') {\n   289\t        await accounts.ensureDefaultClaude().catch(() => null);\n   290\t        const profiles = await Promise.all((await accounts.list()).map(async (profile) => {\n   291\t          if (profile.provider === 'factory-droid') {\n   292\t            return { ...profile, factoryLaunchCommand: profile.factoryHome === homedir() ? 'droid' : `FACTORY_HOME_OVERRIDE=${shellQuote(profile.factoryHome)} droid` };\n   293\t          }\n   294\t          if (profile.provider !== 'claude-code' && profile.provider !== 'antigravity') return profile;\n   295\t          const command = collectCommand(profile.id);\n   296\t          return { ...profile, ...(profile.provider === 'claude-code' ? claudeSetup(profile) : { collectCommand: command }),\n   297\t            collector: await accounts.collectorStatus(profile, command) };\n   298\t        }));\n   299\t        json(response, 200, { profiles }); return;\n   300\t      }\n   301\t      if (path.startsWith('/api/')) {\n   302\t        if (request.method !== 'GET' && request.headers.origin !== `http://${host}`) { response.writeHead(403).end(); return; }\n   303\t        if (path === '/api/profiles' && request.method === 'POST') {\n   304\t          const body = await readJson(request);\n   305\t          json(response, 201, await accounts.addProvider(body)); return;\n   306\t        }\n   307\t        if (path === '/api/profiles/current' && request.method === 'POST') { json(response, 201, await accounts.addCurrent()); return; }\n   308\t        if (path === '/api/profiles/claude-default' && request.method === 'POST') { json(response, 201, await accounts.ensureDefaultClaude({ force: true })); return; }\n   309\t        if (path === '/api/preferences' && request.method === 'PUT') { json(response, 200, await accounts.setUsagePreferences(await readJson(request))); return; }\n   310\t        if (path === '/api/history' && request.method === 'DELETE') {\n   311\t          historyQueue = historyQueue.then(() => rm(historyFile, { force: true })).catch(() => {});\n   312\t          await historyQueue;\n   313\t          json(response, 200, { cleared: true }); return;\n   314\t        }\n   315\t        const resetMatch = path.match(/^\\/api\\/profiles\\/([a-zA-Z0-9_-]{1,64})\\/reset$/);\n   316\t        if (resetMatch && request.method === 'POST') {\n   317\t          const body = await readJson(request);\n   318\t          if (typeof body?.idempotencyKey !== 'string' || !/^[0-9a-f-]{36}$/i.test(body.idempotencyKey)) throw new Error('Invalid reset request.');\n   319\t          const profile = (await accounts.profiles()).find((item) => item.id === resetMatch[1] && item.provider === 'codex-chatgpt');\n   320\t          if (!profile) throw new Error('Account was not found.');\n   321\t          try { json(response, 200, { outcome: await consumeCodexResetCredit(profile, { idempotencyKey: body.idempotencyKey }) }); }\n   322\t          catch { throw new Error('Codex could not use a reset.'); }\n   323\t          return;\n   324\t        }\n   325\t        const collectorMatch = path.match(/^\\/api\\/profiles\\/([a-zA-Z0-9_-]{1,64})\\/collector$/);\n   326\t        if (collectorMatch && request.method === 'POST') { json(response, 200, await accounts.installCollector(collectorMatch[1], collectCommand(collectorMatch[1]))); return; }\n   327\t        if (collectorMatch && request.method === 'DELETE') { json(response, 200, await accounts.uninstallCollector(collectorMatch[1])); return; }\n   328\t        const profileMatch = path.match(/^\\/api\\/profiles\\/([a-zA-Z0-9_-]{1,64})$/);\n   329\t        if (profileMatch && request.method === 'PATCH') {\n   330\t          const body = await readJson(request);\n   331\t          if (!body || typeof body !== 'object' || Object.keys(body).some((key) => key !== 'label')) throw new Error('Invalid usage account configuration.');\n   332\t          json(response, 200, await accounts.renameProfile(profileMatch[1], body.label ?? '')); return;\n   333\t        }\n   334\t        if (profileMatch && request.method === 'DELETE') {\n   335\t          const body = await readJson(request);\n   336\t          if (body?.confirmation !== profileMatch[1]) throw new Error('Invalid account ID.');\n   337\t          json(response, 200, await accounts.removeProfile(profileMatch[1])); return;\n   338\t        }\n   339\t        if (path === '/api/connections' && request.method === 'POST') {\n   340\t          const body = await readJson(request);\n   341\t          json(response, 201, await accounts.startLogin(body?.label)); return;\n   342\t        }\n   343\t        if (path === '/api/connections/active' && request.method === 'GET') { json(response, 200, { connection: accounts.activeConnection() }); return; }\n   344\t        const connectionMatch = path.match(/^\\/api\\/connections\\/([a-zA-Z0-9_-]{1,64})$/);\n   345\t        if (connectionMatch && request.method === 'GET') { json(response, 200, accounts.connection(connectionMatch[1])); return; }\n   346\t        const cancelMatch = path.match(/^\\/api\\/connections\\/([a-zA-Z0-9_-]{1,64})\\/cancel$/);\n   347\t        if (cancelMatch && request.method === 'POST') { json(response, 200, await accounts.cancelLogin(cancelMatch[1])); return; }\n   348\t        response.writeHead(404).end(); return;\n   349\t      }\n   350\t      if (request.method !== 'GET') { response.writeHead(405).end(); return; }\n   351\t    } catch (error) {\n   352\t      json(response, 400, { error: publicErrors.has(error?.message) ? error.message : 'Could not update usage accounts. Check the connection configuration.' });\n   353\t      return;\n   354\t    }\n   355\t    const target = resolve(dist, `.${path === '/' ? '/index.html' : path}`);\n   356\t    if (target !== dist && !target.startsWith(dist + sep)) { response.writeHead(404).end(); return; }\n   357\t    try { const body = await readFile(target); response.setHeader('Content-Type', mime[extname(target)] ?? 'application/octet-stream'); response.writeHead(200).end(body); }\n   358\t    catch { response.writeHead(404).end(); }\n   359\t  });\n   360\t  server.listen(port, '127.0.0.1', () => process.stdout.write(`Subset usage listening on http://127.0.0.1:${port}\\n`));\n   361\t  let stopping = false;\n   362\t  for (const signal of ['SIGINT', 'SIGTERM']) process.on(signal, () => {\n   363\t    if (stopping) process.exit(1);\n   364\t    stopping = true;\n   365\t    // Browser keep-alive connections would otherwise hold the process open after Ctrl-C.\n   366\t    server.close();\n   367\t    server.closeAllConnections();\n   368\t    setTimeout(() => process.exit(1), 5000).unref();\n   369\t    void accounts.close().finally(() => process.exit(0));\n   370\t  });\n   371\t} else {\n   372\t  process.stderr.write('Usage: node server.mjs [status|serve|collect --account <id>]\\n');\n   373\t  process.exitCode = 2;\n   374\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"e6cd6b94-5cb8-45f7-ad85-90ff0b49ccb5","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ccf55d8d-6176-4456-a8a3-555947c35bfe","userType":"external","entrypoint":"cli","cwd":"/Users/serro/Documents/dev/n/subset","sessionId":"ccf55d8d-6176-4456-a8a3-555947c35bfe","version":"2.1.294","gitBranch":"main"}
