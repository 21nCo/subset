     if (!profile.credentialEnv) return fail('factory_token_expired', 'The local Droid sign-in has expired. Run droid with this account to refresh it.', 'unauthorized');\n      } else { auth = localState; source = 'Factory rate limits (local sign-in)'; }\n    }\n  }\n  try {\n    if (!auth) {\n  managedRoot = resolve(homedir(), '.local/share/subset/codex-accounts'),\n  snapshotRoot = resolve(homedir(), '.local/share/subset/usage-snapshots'),\n  currentHome = resolve(process.env.CODEX_HOME ?? join(homedir(), '.codex')),\n  codexBinary = 'codex',\n  loginTimeoutMs = 15 * 60_000,\n  defaultClaudeConfigDir = resolve(process.env.CLAUDE_CONFIG_DIR ?? join(homedir(), '.claude')),\n  preferencesFile = join(dirname(profilesFile), 'usage-preferences.json'),\n  readClaudeAuth = (configDir) => readClaudeAuthStatus(configDir, { defaultConfigDir: defaultClaudeConfigDir }),\n  antigravitySettingsFile = join(homedir(), '.gemini', 'antigravity-cli', 'settings.json'),\n} = {}) {\n  snapshotRoot = resolve(snapshotRoot);\n29:    plan: string(account?.planType, 80), email: isEmail(account?.email) ? account.email : null, observedAt: observedAt.toISOString(), state: 'ok', windows: [], resetCredits: null,","is_error":false}]},"uuid":"7ec1eeb9-dd17-44b8-9760-5088aa6dd07c","timestamp":"2026-10-08T13:48:05.364Z","toolUseResult":{"stdout":" M .gitignore\n M AGENTS.md\n M README.md\n M apps/directory/src/App.svelte\n M docs/architecture.md\n M package-lock.json\n M package.json\n M packages/catalog/src/index.ts\n M scripts/check-workspaces.mjs\n?? .github/workflows/publish-tag.yml\n?? apps/usage/\n?? packages/usage-cli/\n?? packages/usage/\n?? release-packages.json\n?? scripts/generate-provider-logos.mjs\n?? scripts/logos/\n?? scripts/resolve-release-tag.mjs\n72:Exception, directed by the repository owner on 2026-10-08: the local usage host has a **Use local sign-ins** setting. It stays off until the user answers a first-run question on the dashboard, and can be changed in Settings. Only while 