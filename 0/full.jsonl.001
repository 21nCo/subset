{"parentUuid":"028308e3-0c6a-43ad-a9c1-707b6eef3059","isSidechain":false,"promptId":"54454a4d-12b9-4ee3-b2a6-9023849a1ade","type":"user","message":{"role":"user","content":[{"type":"tool_result","content":"Exit code 1\nname: Publish tagged package\n\non:\n  push:\n    tags:\n      - '*-v*.*.*'\n  workflow_dispatch:\n    inputs:\n      release_tag:\n        description: 'Release tag in the form <package-slug>-v<version>'\n        required: true\n        type: string\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: publish-${{ github.ref }}\n  cancel-in-progress: false\n\njobs:\n  publish:\n    runs-on: ubuntu-latest\n    env:\n      RELEASE_TAG: ${{ github.event_name == 'workflow_dispatch' && inputs.release_tag || github.ref_name }}\n\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          registry-url: https://registry.npmjs.org\n\n      - name: Resolve publish target\n        id: resolve\n        run: node ./scripts/resolve-release-tag.mjs \"${RELEASE_TAG}\"\n\n      - name: Install package dependencies\n        working-directory: ${{ steps.resolve.outputs.pkg_path }}\n        run: npm install --workspaces=false --package-lock=false\n\n      - name: Build package\n        working-directory: ${{ steps.resolve.outputs.pkg_path }}\n        run: npm run build\n\n      - name: Test package\n        working-directory: ${{ steps.resolve.outputs.pkg_path }}\n        run: npm test\n\n      - name: Pack package\n        working-directory: ${{ steps.resolve.outputs.pkg_path }}\n        run: npm pack --json\n\n      - name: Publish package\n        working-directory: ${{ steps.resolve.outputs.pkg_path }}\n        run: npm publish --access public\n        env:\n          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}\nimport { appendFile, readFile } from 'node:fs/promises';\nimport path from 'node:path';\nimport process from 'node:process';\nimport { fileURLToPath } from 'node:url';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\nconst repoRoot = path.resolve(__dirname, '..');\nconst releasePackagesPath = path.join(repoRoot, 'release-packages.json');\nconst tagPattern = /^(?<slug>[a-z0-9][a-z0-9-]*)-v(?<version>\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)$/;\n\nfunction fail(message) {\n  console.error(message);\n  process.exit(1);\n}\n\nasync function loadReleaseTargets() {\n  const raw = await readFile(releasePackagesPath, 'utf8');\n  const releasePackages = JSON.parse(raw);\n\n  if (!Array.isArray(releasePackages)) {\n    fail(`Expected ${path.relative(repoRoot, releasePackagesPath)} to contain an array`);\n  }\n\n  const targets = [];\n\n  for (const entry of releasePackages) {\n    if (!entry?.slug || !entry?.path || !entry?.name) {\n      fail(`Invalid release target entry in ${path.relative(repoRoot, releasePackagesPath)}: ${JSON.stringify(entry)}`);\n    }\n\n    targets.push({\n      slug: entry.slug,\n      name: entry.name,\n      path: entry.path,\n    });\n  }\n\n  return targets;\n}\n\nasync function writeOutputs(outputs) {\n  if (!process.env.GITHUB_OUTPUT) {\n    return;\n  }\n\n  const lines = Object.entries(outputs).map(([key, value]) => `${key}=${value}`);\n  await appendFile(process.env.GITHUB_OUTPUT, `${lines.join('\\n')}\\n`);\n}\n\nconst tag = process.argv[2] ?? process.env.GITHUB_REF_NAME;\n\nif (!tag) {\n  fail('Expected a release tag argument or GITHUB_REF_NAME');\n}\n\nconst match = tag.match(tagPattern);\n\nif (!match?.groups) {\n  fail(`Unsupported tag format: ${tag}. Expected <package-slug>-v<version>.`);\n}\n\nconst { slug, version } = match.groups;\nconst releaseTargets = await loadReleaseTargets();\nconst target = releaseTargets.find((candidate) => candidate.slug === slug);\n\nif (!target) {\n  const supportedSlugs = releaseTargets.map((target) => target.slug).join(', ');\n  fail(`No publishable workspace found for slug \"${slug}\". Supported slugs: ${supportedSlugs}`);\n}\n\nconst packageJsonFile = path.join(repoRoot, target.path, 'package.json');\nconst packageJson = JSON.parse(await readFile(packageJsonFile, 'utf8'));\n\nif (packageJson.name !== target.name) {\n  fail(\n    `Release target ${target.slug} expected ${target.name} at ${target.path}/package.json, found ${packageJson.name ?? 'undefined'}`,\n  );\n}\n\nif (packageJson.version !== version) {\n  fail(`Tag version ${version} does not match ${target.name}@${packageJson.version} in ${target.path}/package.json`);\n}\n\nawait writeOutputs({\n  pkg_slug: target.slug,\n  pkg_name: target.name,\n  pkg_version: packageJson.version,\n  pkg_path: target.path,\n});\n\nconsole.log(\n  JSON.stringify(\n    {\n      tag,\n      slug: target.slug,\n      name: target.name,\n      version: packageJson.version,\n      path: target.path,\n    },\n    null,\n    2,\n  ),\n);\n[\n  { \"slug\": \"apifn-cli\", \"path\": \"apifn/cli\", \"name\": \"@apifn/cli\" },\n  { \"slug\": \"apifn-collections\", \"path\": \"apifn/collections\", \"name\": \"@apifn/collections\" },\n  { \"slug\": \"apifn-core\", \"path\": \"apifn/core\", \"name\": \"@apifn/core\" },\n  { \"slug\": \"apifn-docsfn\", \"path\": \"apifn/docsfn\", \"name\": \"@apifn/docsfn\" },\n  { \"slug\": \"apifn-mock\", \"path\": \"apifn/mock\", \"name\": \"@apifn/mock\" },\n  { \"slug\": \"apifn-react\", \"path\": \"apifn/react\", \"name\": \"@apifn/react\" },\n  { \"slug\": \"apifn-snippets\", \"path\": \"apifn/snippets\", \"name\": \"@apifn/snippets\" },\n  { \"slug\": \"apifn-svelte\", \"path\": \"apifn/svelt\ncli\n1\nnode:internal/modules/cjs/loader:1386\n  throw err;\n  ^\n\nError: Cannot find module './node_modules/esbuild/package.json'\nRequire stack:\n- /Users/serro/Documents/dev/n/subset/[eval]\n    at Function._resolveFilename (node:internal/modules/cjs/loader:1383:15)\n    at defaultResolveImpl (node:internal/module