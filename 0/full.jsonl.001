, Claude, Cursor, Factory, Amp, Devin, and more\",","+  \"license\": \"MIT\",","+  \"private\": false,","+  \"type\": \"module\",","+  \"bin\": {","+    \"subset-usage\": \"dist/cli.mjs\"","+  },","+  \"files\": [","+    \"dist\",","+    \"web\",","+    \"README.md\"","+  ],","+  \"engines\": {","+    \"node\": \">=22\"","+  },","+  \"repository\": {","+    \"type\": \"git\",","+    \"url\": \"git+https://github.com/21nCo/subset.git\",","+    \"directory\": \"packages/usage-cli\"","+  },","+  \"homepage\": \"https://github.com/21nCo/subset/tree/main/packages/usage-cli#readme\",","+  \"publishConfig\": {","+    \"access\": \"public\"","+  },","+  \"scripts\": {","+    \"build\": \"node scripts/build.mjs\",","+    \"test\": \"node --test test/*.test.mjs\",","+    \"status\": \"node src/server.mjs status\",","+    \"serve\": \"node src/server.mjs serve --no-open\",","+    \"prepack\": \"node scripts/build.mjs --check\"","+  },","+  \"devDependencies\": {","+    \"@subset/usage\": \"*\",","+    \"@subset/usage-web\": \"*\",","+    \"rolldown\": \"1.2.11\"","+  }","+}"]}],"created":true},{"filePath":"/Users/serro/Documents/dev/n/subset/packages/usage-cli/scripts/build.mjs","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":31,"lines":["+// Bundles the CLI with the private @subset/usage package inlined, and copies the built","+// dashboard from apps/usage/dist into web/. The published package has no runtime dependencies.","+import { cp, mkdir, readFile, rm, stat } from 'node:fs/promises';","+import { fileURLToPath } from 'node:url';","+import { build } from 'rolldown';","+","+const root = fileURLToPath(new URL('..', import.meta.url));","+const webSource = fileURLToPath(new URL('../../../apps/usage/dist/', import.meta.url));","+const exists = (path) => stat(path).then(() => true, () => false);","+","+if (process.argv.includes('--check')) {","+  // prepack: refuse to pack without both halves.","+  for (const file of ['dist/cli.mjs', 'web/index.html']) {","+    if (!(await exists(`${root}${file}`))) { console.error(`Missing ${file}. Run npm run build at the repository root first.`); process.exit(1); }","+  }","+  const head = (await readFile(`${root}dist/cli.mjs`, 'utf8')).slice(0, 40);","+  if (!head.startsWith('#!/usr/bin/env node')) { console.error('dist/cli.mjs has no shebang.'); process.exit(1); }","+  process.exit(0);","+}","+","+await rm(`${root}dist`, { recursive: true, force: true });","+await build({","+  input: `${root}src/server.mjs`,","+  platform: 'node',","+  external: [/^node:/],","+  output: { file: `${root}dist/cli.mjs`, format: 'esm', banner: '#!/usr/bin/env node' },","+});","+if (!(await exists(`${webSource}index.html`))) { console.error('apps/usage/dist is missing. Build @subset/usage-web first.'); process.exit(1); }","+await rm(`${root}web`, { recursive: true, force: true });","+await mkdir(`${root}web`, { recursive: true });","+await cp(webSource, `${root}web`, { recursive: true });"]}],"created":true}],"moreFiles":0,"changedFiles":["/Users/serro/Documents/dev/n/subset/.gitignore","/Users/serro/Documents/dev/n/subset/apps/usage/package.json","/Users/serro/Documents/dev/n/subset/package.json","/Users/serro/Documents/dev/n/subset/packages/usage-cli/package.json","/Users/serro/Documents/dev/n/subset/packages/usage-cli/scripts/build.mjs"]}},"sourceToolAssistantUUID":"d944eb12-59ca-4dcd-b384-eeb3a42f4234","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ccf55d8d-6176-4456-a8a3-555947c35bfe","userType":"external","entrypoint":"cli","cwd":"/Users/serro/Documents/dev/n/subset","sessionId":"ccf55d8d-6176-4456-a8a3-555947c35bfe","version":"2.1.294","gitBranch":"main","slug":"declarative-hopping-teapot"}
