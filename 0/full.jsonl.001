{"parentUuid":"f1239be7-cd4b-4312-bf2f-e09cfed6c051","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/serro/Documents/dev/n/subset/packages/usage/src/history.ts","snippet":"8\t  schemaVersion: 1;\n9\t  /** accountId -> windowKey -> [observedAt epoch ms, used percent] in ascending time. */\n10\t  series: Record<string, Record<string, Array<[number, number]>>>;\n11\t}\n12\t\n13\texport const HISTORY_MAX_AGE_MS = 8 * 24 * 60 * 60_000;\n14\tconst MAX_POINTS = 2000;\n15\tconst MIN_INTERVAL_MS = 4 * 60_000;\n16\tconst MAX_ACCOUNTS = 50;\n17\tconst MAX_WINDOWS = 100;\n18\t\n19\texport const historyWindowKey = (window: Pick<UsageWindow, 'limitId' | 'label'>) => `${window.limitId}\\u0000${window.label}`;\n20\texport const emptyUsageHistory = (): UsageHistory => ({ schemaVersion: 1, series: {} });\n21\t\n22\texport function isUsageHistory(value: unknown): value is UsageHistory {\n23\t  const record = (item: unknown): item is Record<string, unknown> => !!item && typeof item === 'object' && !Array.isArray(item);\n24\t  if (!record(value) || value.schemaVersion !== 1 || !record(value.series)) return false;\n...\n26\t  if (accounts.length > MAX_ACCOUNTS) return false;\n27\t  return accounts.every(([id, windows]) => /^[a-zA-Z0-9_-]{1,64}$/.test(id) && record(windows) && Object.keys(windows).length <= MAX_WINDOWS\n28\t    && Object.entries(windows).every(([key, points]) => key.length <= 400 && Array.isArray(points) && points.length <= MAX_POINTS\n29\t      && points.every((point) => Array.isArray(point) && point.length === 2 && Number.isSafeInteger(point[0]) && point[0] >= 0\n30\t        && typeof point[1] === 'number' && Number.isFinite(point[1]) && point[1] >= 0 && point[1] <= 100)));\n31\t}\n32\t\n33\t/**\n34\t * Adds each account's newest observation. Repeated reads of the same observation are ignored and unchanged values\n35\t * closer than four minutes apart are thinned. Series are kept until their points pass the eight-day retention, so a\n36\t * failed or partial read never erases history; `removeHistoryAccount` drops an account explicitly.\n37\t */\n38\texport function recordUsageHistory(history: UsageHistory, status: UsageStatus, now = Date.now()): UsageHistory {\n39\t  const cutoff = now - HISTORY_MAX_AGE_MS;\n40\t  const series: UsageHistory['series'] = {};\n41\t  // Start from everything already recorded, pruned to the retention window.\n42\t  for (const [accountId, windows] of Object.entries(history.series)) {\n43\t    const kept: Record<string, Array<[number, number]>> = {};\n44\t    for (const [key, points] of Object.entries(windows)) {\n45\t      const recent = points.filter(([time]) => time >= cutoff && time <= now);\n46\t      if (recent.length) kept[key] = recent;\n47\t    }\n48\t    if (Object.keys(kept).length) series[accountId] = kept;\n49\t  }\n50\t  for (const account of status.accounts) {\n51\t    const observed = account.observedAt ? Date.parse(account.observedAt) : NaN;\n52\t    if (!Number.isFinite(observed) || observed < cutoff || observed > now) continue;\n53\t    const windows = series[account.id] ?? {};\n54\t    for (const window of account.windows) {\n55\t      if (window.usedPercent === null) continue;\n56\t      const key = historyWindowKey(window);\n57\t      const points = windows[key] ?? [];\n58\t      const last = points.at(-1);\n59\t      const used = Math.round(window.usedPercent * 100) / 100;\n60\t      if (!last || (observed > last[0] && (used !== last[1] || observed - last[0] >= MIN_INTERVAL_MS))) points.push([observed, used]);\n61\t      windows[key] = points.slice(-MAX_POINTS);\n62\t    }\n63\t    if (Object.keys(windows).length) series[account.id] = windows;\n64\t  }\n65\t  // Keep the most recently observed accounts when over the cap.\n66\t  const latest = (windows: Record<string, Array<[number, number]>>) => Math.max(...Object.values(windows).map((points) => points.at(-1)?.[0] ?? 0));\n67\t  const ordered = Object.entries(series).sort((a, b) => latest(b[1]) - latest(a[1])).slice(0, MAX_ACCOUNTS);\n68\t  const windowsCapped = ordered.map(([id, windows]) => [id, Object.fromEntries(Object.entries(windows).slice(0, MAX_WINDOWS))] as const);\n69\t  return { schemaVersion: 1, series: Object.fromEntries(windowsCapped) };\n70\t}\n71\t\n72\t/** Drops one account's history, for example when the account is removed. */\n73\texport function removeHistoryAccount(history: UsageHistory, accountId: string): UsageHistory {\n74\t  const { [accountId]: _removed, ...series } = history.series;\n75\t  return { schemaVersion: 1, series };\n76\t}"},"type":"attachment","uuid":"8ced2a14-419d-4d49-b24e-fb8ffd0a9fcb","timestamp":"2026-10-08T13:13:20.772Z","rendered":[{"content":"<system-reminder>\nNote: /Users/serro/Documents/dev/n/subset/packages/usage/src/history.ts changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n8\t  schemaVersion: 1;\n9\t  /** accountId -> windowKey -> [observedAt epoch ms, used percent] in ascending time. */\n10\t  series: Record<string, Record<string, Array<[number, number]>>>;\n11\t}\n12\t\n13\texport const HISTORY_MAX_AGE_MS = 8 * 24 * 60 * 60_000;\n14\tconst MAX_POINTS = 2000;\n15\tconst MIN_INTERVAL_MS = 4 * 60_000;\n16\tconst MAX_ACCOUNTS = 50;\n17\tconst MAX_WINDOWS = 100;\n18\t\n19\texport const historyWindowKey = (window: Pick<UsageWindow, 'limitId' | 'label'>) => `${window.limitId}\\u0000${window.label}`;\n20\texport const emptyUsageHistory = (): UsageHistory => ({ schemaVersion: 1, series: {} });\n21\t\n22\texport function isUsageHistory(value: unknown): value is UsageHistory {\n23\t  const record = (item: unknown): item is Record<string, unknown> => !!item && typeof item === 'object' && !Array.isArray(item);\n24\t  if (!record(value) || value.schemaVersion !== 1 || !record(value.series)) return false;\n...\n26\t  if (accounts.length > MAX_ACCOUNTS) return false;\n27\t  return accounts.every(([id, windows]) => /^[a-zA-Z0-9_-]{1,64}$/.test(id) && record(windows) && Object.keys(windows).length <= MAX_WINDOWS\n28\t    && Object.entries(windows).every(([key, points]) => key.length <= 400 && Array.isArray(points) && points.length <= MAX_POINTS\n29\t      && points.every((point) => Array.isArray(point) && point.length === 2 && Number.isSafeInteger(point[0]) && point[0] >= 0\n30\t        && typeof point[1] === 'number' && Number.isFinite(point[1]) && point[1] >= 0 && point[1] <= 100)));\n31\t}\n32\t\n33\t/**\n34\t * Adds each account's newest observation. Repeated reads of the same observation are ignored and unchanged values\n35\t * closer than four minutes apart are thinned. Series are kept until their points pass the eight-day retention, so a\n36\t * failed or partial read never erases history; `removeHistoryAccount` drops an account explicitly.\n37\t */\n38\texport function recordUsageHistory(history: UsageHistory, status: UsageStatus, now = Date.now()): UsageHistory {\n39\t  const cutoff = now - HISTORY_MAX_AGE_MS;\n40\t  const series: UsageHistory['series'] = {};\n41\t  // Start from everything already recorded, pruned to the retention window.\n42\t  for (const [accountId, windows] of Object.entries(history.series)) {\n43\t    const kept: Record<string, Array<[number, number]>> = {};\n44\t    for (const [key, points] of Object.entries(windows)) {\n45\t      const recent = points.filter(([time]) => time >= cutoff && time <= now);\n46\t      if (recent.length) kept[key] = recent;\n47\t    }\n48\t    if (Object.keys(kept).length) series[accountId] = kept;\n49\t  }\n50\t  for (const account of status.accounts) {\n51\t    const observed = account.observedAt ? Date.parse(account.observedAt) : NaN;\n52\t    if (!Number.isFinite(observed) || observed < cutoff || observed > now) continue;\n53\t    const windows = series[account.id] ?? {};\n54\t    for (const window of account.windows) {\n55\t      if (window.usedPercent === null) continue;\n56\t      const key = historyWindowKey(window);\n57\t      const points = windows[key] ?? [];\n58\t      const last = points.at(-1);\n59\t      const used = Math.round(window.usedPercent * 100) / 100;\n60\t      if (!last || (observed > last[0] && (used !== last[1] || observed - last[0] >= MIN_INTERVAL_MS))) points.push([observed, used]);\n61\t      windows[key] = points.slice(-MAX_POINTS);\n62\t    }\n63\t    if (Object.keys(windows).length) series[account.id] = windows;\n64\t  }\n65\t  // Keep the most recently observed accounts when over the cap.\n66\t  const latest = (windows: Record<string, Array<[number, number]>>) => Math.max(...Object.values(windows).map((points) => points.at(-1)?.[0] ?? 0));\n67\t  const ordered = Object.entries(series).sort((a, b) => latest(b[1]) - latest(a[1])).slice(0, MAX_ACCOUNTS);\n68\t  const windowsCapped = ordered.map(([id, windows]) => [id, Object.fromEntries(Object.entries(windows).slice(0, MAX_WINDOWS))] as const);\n69\t  return { schemaVersion: 1, series: Object.fromEntries(windowsCapped) };\n70\t}\n71\t\n72\t/** Drops one account's history, for example when the account is removed. */\n73\texport function removeHistoryAccount(history: UsageHistory, accountId: string): UsageHistory {\n74\t  const { [accountId]: _removed, ...series } = history.series;\n75\t  return { schemaVersion: 1, series };\n76\t}\n</system-reminder>"}],"renderedRole":"system","session_id":"ccf55d8d-6176-4456-a8a3-555947c35bfe","userType":"external","entrypoint":"cli","cwd":"/Users/serro/Documents/dev/n/subset","sessionId":"ccf55d8d-6176-4456-a8a3-555947c35bfe","version":"2.1.294","gitBranch":"main"}
